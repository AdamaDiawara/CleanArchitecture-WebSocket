// --- restaurants.prisma ---
model Restaurant {
    id              String         @id @default(uuid())
    owner_id        String // FK → users
    name            String
    description     String?
    logo_url        String?
    address         String
    lat             Float
    lng             Float
    opening_hours   Json
    is_active       Boolean
    rating_avg      Float?
    cuisine_type    String
    prep_time_min   Int
    delivery_fee    Float
    menu_categories MenuCategory[] @relation("RestaurantCategories")
}

// --- menu_categories.prisma ---
model MenuCategory {
    id            String                   @id @default(uuid())
    restaurant_id String
    name          String
    position      Int
    availability  MenuCategoryAvailability
    restaurant    Restaurant               @relation(fields: [restaurant_id], references: [id], name: "RestaurantCategories")
    menu_items    MenuItem[]               @relation("CategoryItems")
}

enum MenuCategoryAvailability {
    always
    lunch
    dinner
    weekend
}

// --- menu_items.prisma ---
model MenuItem {
    id           String           @id @default(uuid())
    category_id  String
    name         String
    description  String?
    photo_url    String?
    price        Float
    is_available Boolean
    is_popular   Boolean
    category     MenuCategory     @relation(fields: [category_id], references: [id], name: "CategoryItems")
    options      MenuItemOption[] @relation("ItemOptions")
}

// --- menu_item_options.prisma ---
model MenuItemOption {
    id          String                @id @default(uuid())
    item_id     String
    name        String
    type        MenuItemOptionType
    is_required Boolean
    item        MenuItem              @relation(fields: [item_id], references: [id], name: "ItemOptions")
    values      MenuItemOptionValue[] @relation("OptionValues")
}

enum MenuItemOptionType {
    single
    multiple
}

// --- menu_item_option_values.prisma ---
model MenuItemOptionValue {
    id          String         @id @default(uuid())
    option_id   String
    label       String
    extra_price Float
    option      MenuItemOption @relation(fields: [option_id], references: [id], name: "OptionValues")
}
