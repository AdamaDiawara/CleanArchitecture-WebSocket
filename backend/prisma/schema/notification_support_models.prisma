// --- notification_support_models.prisma ---

model Notification {
    id      String              @id @default(uuid())
    user_id String
    channel NotificationChannel
    type    String
    title   String
    body    String
    is_read Boolean
    sent_at DateTime
}

enum NotificationChannel {
    push
    sms
    email
}

model SupportTicket {
    id         String           @id @default(uuid())
    user_id    String
    order_id   String
    reason     SupportReason
    status     SupportStatus
    created_at DateTime         @default(now())
    messages   SupportMessage[]
}

enum SupportReason {
    missing_item
    wrong_item
    other
}

enum SupportStatus {
    open
    in_progress
    resolved
}

model SupportMessage {
    id        String        @id @default(uuid())
    ticket_id String
    sender_id String
    role      SupportRole
    content   String
    sent_at   DateTime
    ticket    SupportTicket @relation(fields: [ticket_id], references: [id])
}

enum SupportRole {
    user
    agent
    bot
}
